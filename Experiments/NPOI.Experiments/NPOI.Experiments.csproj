<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NPOI" Version="2.7.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OpenXML.Templater\OpenXML.Templater.csproj" />
    <ProjectReference Include="..\..\OpenXML.Xlsx.Templater\OpenXML.Xlsx.Templater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="XlsTemplates\StaticTextInline.xlsx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="XlsTemplates\StaticTextOnly.xlsx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
